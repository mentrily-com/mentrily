{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "supabase:deploy": "bash supabase/deploy_supabase.sh",
    "supabase:rls:tokens": "bash supabase/generate_rls_test_tokens.sh",
    "supabase:data:export": "bash supabase/data-migration/export_data.sh",
    "supabase:data:import": "bash supabase/data-migration/import_data.sh",
    "supabase:data:verify": "bash supabase/data-migration/verify_data.sh",
    "seed:college-demo": "ts-node prisma/seed-college-demo.ts",
    "seed:showcase": "ts-node --transpile-only --compiler-options \"{\\\"module\\\":\\\"commonjs\\\",\\\"moduleResolution\\\":\\\"node\\\"}\" ../course-demo/seed.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "knip": "knip --config knip.config.ts",
    "check": "npm run typecheck",
    "check:full": "npm run lint && npm run typecheck && npm run knip",
    "eb:env-options": "node scripts/env-to-eb-options.mjs .env /tmp/backend-eb-options.json",
    "eb:dockerrun": "node scripts/create-dockerrun.mjs",
    "clean": "rm -rf dist coverage .tsbuildinfo",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@aws-sdk/s3-request-presigner": "^3.962.0",
    "@clerk/backend": "^2.22.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.10",
    "@nestjs/platform-socket.io": "^11.1.10",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.10",
    "@prisma/client": "^6.19.1",
    "@sentry/node": "^10.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/postgrest-js": "^2.103.3",
    "@supabase/supabase-js": "^2.57.4",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "ajv": "^8.17.1",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.66.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dd-trace": "^5.81.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.8.2",
    "ipaddr.js": "^2.4.0",
    "nanoid": "^5.1.7",
    "pdfkit": "^0.17.2",
    "peer": "^1.0.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.0.0",
    "svix": "^1.56.0",
    "undici": "^8.10.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "knip": "^6.4.1",
    "prettier": "^3.4.2",
    "prisma": "^6.19.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
