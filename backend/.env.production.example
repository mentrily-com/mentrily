NODE_ENV=production
PORT=3000
TZ=Asia/Kathmandu

APP_DOMAIN=example.com
APP_NAME=Blockscode
APP_URL=https://example.com
FRONTEND_URL=https://example.com

DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require&pgbouncer=true
SUPABASE_DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_GRAPHQL_URL=https://project-ref.supabase.co/graphql/v1

# Prefer managed Redis in production. If REDIS_URL is omitted and REDIS_HOST is localhost,
# the Docker image starts an embedded Redis process for single-instance Beanstalk.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

CLERK_SECRET_KEY=replace-me
CLERK_WEBHOOK_SECRET=replace-me
JWT_SECRET=replace-me
COOKIE_SECRET=replace-me

MAILJET_API_KEY=replace-me
MAILJET_API_SECRET=replace-me
MAILJET_SENDER_EMAIL=no-reply@example.com
MAILJET_SENDER_NAME=Blockscode

GROK_API_KEY=replace-me

# Judge0 is the execution engine. Unsupported Judge0 languages are rejected.
CODE_EXECUTION_ENGINE=judge0
JUDGE0_API_URL=http://3.109.55.59:2358
PISTON_API_URL=https://emkc.org/api/v2/piston

# Storage (AWS S3 + CloudFront CDN in front of a private bucket)
S3_REGION=ap-south-1
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET_NAME=replace-me
S3_CDN_URL=https://cdn.example.com

STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PRICE_STARTER=replace-me
STRIPE_PRICE_PRO=replace-me
STRIPE_PRICE_ENTERPRISE=replace-me

RUN_MIGRATIONS_ON_START=false
PRISMA_EAGER_CONNECT=false
PRISMA_CONNECTION_LIMIT=12
PRISMA_POOL_TIMEOUT=20
PRISMA_CONNECT_TIMEOUT=20
PRISMA_PGBOUNCER=true

ENABLE_LOCAL_PEER_SERVER=false
ENABLE_TEST_CODE_ROTATION=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
