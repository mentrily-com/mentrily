generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_DIRECT_URL")
  directUrl = env("SUPABASE_DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN

  @@map("Role")
}

enum BugReportStatus {
  OPEN
  FIXED

  @@map("bug_report_status")
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE

  @@map("Plan")
}

enum PlanStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING

  @@map("PlanStatus")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("MembershipStatus")
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String? // Hashed password
  clerkId            String?  @unique
  name               String?
  profilePicture     String?
  rollNumber         String?  @unique // Explicitly requested field
  department         String?
  role               Role     @default(STUDENT)
  needsRoleSelection Boolean  @default(false)
  hasCompletedOnboarding Boolean @default(false)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean? @default(false)

  sessions  ExamSession[]
  auditLogs AuditLog[]
  feedbacks Feedback[]

  // Course & Unit relations
  courses Course[] @relation("CourseStudents")

  // Ownership relations
  createdExams   Exam[]   @relation("ExamCreator")
  createdCourses Course[] @relation("CourseCreator")

  unitSubmissions UnitSubmission[]
  bookmarks       Bookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Persistence for Student Stats
  dailyStreak      Int       @default(0)
  lastActivityDate DateTime?
  totalXP          Int       @default(0)

  // Course Progress Relation
  progress         CourseProgress[]
  questionAttempts QuestionAttempt[]
  publicCodingQuestions PublicCodingQuestion[] @relation("PublicCodingQuestionCreator")

  // Groups & Announcements
  teacherGroups        StudentGroup[]     @relation("TeacherGroups")
  groupMemberships     StudentGroup[]     @relation("GroupStudents")
  teacherAnnouncements Announcement[]     @relation("TeacherAnnouncements")
  readAnnouncements    AnnouncementRead[]
  bugReports           BugReport[]        @relation("UserBugReports")
  fixedBugReports      BugReport[]        @relation("BugReportFixer")
  aiUsages             AiUsage[]
  certificates         Certificate[]
  createdCertificateTemplates CertificateTemplate[] @relation("CertificateTemplateCreator")
  assignedCourses     CourseAssignment[] @relation("CourseAssignmentTeacher")
  madeAssignments     CourseAssignment[] @relation("CourseAssignmentAssigner")

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  // Multi-org membership: orgId/role above remain the user's home org (never
  // overwritten by joining a second org — see OrgMembership). lastActiveOrgId
  // is the org the workspace switcher last pointed at, used to default the
  // active org on a fresh session when no X-Active-Org-Id header is sent.
  lastActiveOrgId String?
  memberships     OrgMembership[]

  @@index([email])
  @@index([clerkId])
  @@index([role])
  @@index([orgId])
}

model Exam {
  id               String   @id @default(uuid())
  slug             String
  title            String
  shortDescription String?
  longDescription  String?
  difficulty       String? // Beginner, Intermediate, Advanced
  tags             String[] @default([])
  duration         Int // Duration in minutes
  totalMarks       Int?
  passingPercentage Int?
  maxAttempts      Int?
  attemptBufferMins Int?

  // Access & Auth
  testCode         String?
  testCodeType     String? // Permanent, Rotating
  rotationInterval Int?
  inviteToken      String?
  allowedIPs       String?

  // Security
  examMode       String? // Browser, App
  aiProctoring   Boolean @default(false)
  tabSwitchLimit Int?
  strictness     String  @default("high") // high, medium, relaxed

  // Scheduling
  startTime DateTime?
  endTime   DateTime?

  questions        Json // Stored as JSON: Assessment sections/questions
  isActive         Boolean @default(true)
  resultsPublished Boolean @default(false)
  aiTokensUsed     Int?    @default(0)

  submissions ExamSession[]
  feedbacks   Feedback[]

  // Ownership
  creatorId String?
  creator   User?   @relation("ExamCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  linkedCourseId String? @unique
  linkedCourse   Course? @relation("ExamLinkedCourse", fields: [linkedCourseId], references: [id], onDelete: SetNull)

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, orgId])
  @@index([creatorId])
  @@index([orgId])
  @@index([slug])
  @@index([testCode])
}

model ExamSession {
  id     String @id @default(uuid())
  userId String
  examId String
  attemptNumber Int @default(1)

  status    String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, TERMINATED
  startTime DateTime  @default(now())
  endTime   DateTime?
  timeTakenSec Int?

  score   Float?
  answers Json? // Final snapshot of answers: { "q1": "answer" }

  // Security Context
  ipAddress  String?
  deviceId   String?
  vmDetected Boolean @default(false)

  violations Violation[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([examId])
  @@index([status]) // Used in active session filtering
  @@index([userId, status]) // Compound for "active sessions by user"
  @@index([userId, examId, attemptNumber])
  @@index([userId, examId, status]) // Hot path: start/resume session + attempt counting
}

model Violation {
  id        String   @id @default(uuid())
  sessionId String
  type      String // TAB_SWITCH, VM_DETECTED, MUTIPLE_FACES
  severity  String // WARNING, CRITICAL
  message   String?
  timestamp DateTime @default(now())
  proofUrl  String? // URL to screenshot/log if applicable

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([type])
  @@index([sessionId, type])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   Json?
  ip        String?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Feedback {
  id     String @id @default(uuid())
  userId String
  examId String

  rating    Int // 1-5
  comment   String?
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId]) // Ensure one feedback per user per exam
  @@index([examId])
}

model Course {
  id               String   @id @default(uuid())
  title            String
  slug             String
  shortDescription String?
  longDescription  String?
  difficulty       String? // Beginner, Intermediate, Advanced
  tags             String[] @default([])
  thumbnail        String?
  courseSummary    String? // AI Generated Syllabus / Cheat Sheet
  isVisible        Boolean  @default(false)
  status           String   @default("Draft") // Draft, Published, Archived
  aiTokensUsed     Int?     @default(0)
  certificateTemplateId String?
  completionThreshold   Int     @default(100)
  linkedExamId          String? @unique
  examPassThreshold     Int?
  examUnlockThreshold   Int     @default(100)

  modules CourseModule[]
  tests   CourseTest[]
  assignments CourseAssignment[]

  // Implicit many-to-many
  students User[] @relation("CourseStudents")

  // Ownership
  creatorId String?
  creator   User?   @relation("CourseCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  linkedExam           Exam?                @relation("ExamLinkedCourse")
  certificateTemplate  CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress CourseProgress[]

  @@unique([slug, orgId])
  @@index([creatorId])
  @@index([orgId])
  @@index([slug])
}

model CourseModule {
  id       String @id @default(uuid())
  title    String
  order    Int
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Unit {
  id    String @id @default(uuid())
  title String
  type  String // MCQ, Coding, Web, Reading, Notebook
  order Int

  content Json // Stores all config: codingConfig, webConfig, mcqOptions, readingContent

  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  submissions UnitSubmission[]
  bookmarks   Bookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model CourseTest {
  id        String @id @default(uuid())
  slug      String
  title     String
  questions Json // Stored as JSON: Assessment sections/questions

  startDate DateTime?
  endDate   DateTime?

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, orgId])
  @@index([orgId])
  @@index([courseId])
}

model UnitSubmission {
  id     String @id @default(uuid())
  userId String
  unitId String

  status  String // IN_PROGRESS, COMPLETED
  content Json // User's code/answer
  score   Float?
  startedAt DateTime?
  timeTakenSec Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@unique([userId, unitId]) // Allow multiple attempts

  @@index([userId])
  @@index([unitId])
  @@index([status])
  @@index([userId, unitId, status]) // Compound for progress calculations
  @@index([createdAt]) // Used in weekly activity analytics
}

model PublicCodingQuestion {
  id            String   @id @default(uuid())
  slug          String   @unique
  question      Json
  creatorUserId String?
  creator       User?    @relation("PublicCodingQuestionCreator", fields: [creatorUserId], references: [id], onDelete: SetNull)
  creatorIp     String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([creatorUserId])
  @@index([creatorIp])
  @@index([expiresAt])
}

model Organization {
  id     String @id @default(uuid())
  name   String
  status String @default("Active") // Active, Suspended

  // Branding & Configuration
  logo   String?
  domain String?

  // Usage Limits
  maxUsers      Int @default(100)
  maxCourses    Int @default(5)
  storageLimit  Int @default(1024) // in MB
  examsPerMonth Int @default(50)

  // Plan, Billing & Overrides
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  stripePriceId        String?
  planExpiresAt        DateTime?
  billingEmail         String?
  provisionedFromUserId String?

  // Denormalized counters for quota checks
  studentCount     Int   @default(0)
  courseCount      Int   @default(0)
  storageUsedMb    Float @default(0)
  teacherSeatCount Int   @default(0)
  maxAdminSeats    Int?

  features     Json? // Stores enabled features { canCreateExams: true, etc. }
  primaryColor String? @default("#008D98")
  contact      Json? // Stores address, city, country, phone, supportEmail, adminEmail

  users              User[]
  courses            Course[]
  exams              Exam[]
  courseTests        CourseTest[]
  aiUsages           AiUsage[]
  pendingInvites     PendingInvite[]
  subscriptionEvents SubscriptionEvent[]
  usageLedger        UsageLedger[]
  webhookEndpoints   WebhookEndpoint[]
  certificates       Certificate[]
  certificateTemplates CertificateTemplate[]

  // Groups & Announcements
  studentGroups StudentGroup[]
  announcements Announcement[]
  bugReports    BugReport[]

  memberships OrgMembership[]

  planStatus       PlanStatus @default(ACTIVE)
  slug             String?    @unique
  customDomain     String?    @unique
  trialEndsAt      DateTime?
  codeExecCount    Int        @default(0)
  storageAlertSent Boolean    @default(false)
  studentAlertSent Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseAssignment {
  id           String   @id @default(cuid())
  courseId      String
  teacherId     String?
  assignedById  String?
  createdAt     DateTime @default(now())

  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      User?  @relation("CourseAssignmentTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  assignedBy   User?  @relation("CourseAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([courseId, teacherId])
  @@index([teacherId])
  @@index([courseId])
}

model Certificate {
  id                String   @id
  userId            String
  orgId             String
  type              String
  resourceId        String
  title             String
  score             Float?
  completionPercent Int?
  fileUrl           String
  templateId        String?
  qrCode            String
  verificationUrl   String
  metadata          Json?
  issuedAt          DateTime @default(now())
  createdAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template     CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([userId, type, resourceId])
  @@unique([qrCode])
  @@index([userId, issuedAt])
  @@index([orgId])
  @@index([templateId])
}

model CertificateTemplate {
  id            String   @id @default(uuid())
  orgId         String
  creatorId     String
  name          String
  layout        Json
  backgroundUrl String?
  signatureUrl  String?
  logoPosition  Json?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("CertificateTemplateCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  courses      Course[]
  certificates Certificate[]

  @@unique([orgId, name])
  @@index([orgId, isDefault])
  @@index([creatorId])
}

model UsageLedger {
  id        String   @id @default(cuid())
  orgId     String
  eventType String
  valueNum  Float    @default(0)
  meta      Json?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([eventType])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  orgId     String
  url       String
  secret    String
  events    String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model SubscriptionEvent {
  id            String   @id @default(uuid())
  orgId         String
  stripeEventId String   @unique
  eventType     String
  previousPlan  Plan?
  newPlan       Plan?
  metadata      Json?
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model PendingInvite {
  id                String   @id @default(uuid())
  // Was @unique on its own — blocked inviting the same email to a second
  // org. Uniqueness is now per (email, orgId) so a person can have separate
  // outstanding invites at different orgs simultaneously.
  email             String
  role              Role     @default(STUDENT)
  orgId             String
  clerkInvitationId String?
  name              String?
  department        String?
  rollNumber        String?
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([email, orgId])
  @@index([orgId])
  @@index([email])
  @@index([expiresAt])
}

// A person's role in one specific org. User.orgId/role above stay the
// person's home org and are never overwritten by this table — joining a
// second org only ever adds a row here. ClerkAuthGuard resolves the
// request's effective role/orgId from whichever membership is "active"
// (X-Active-Org-Id header, falling back to lastActiveOrgId, falling back to
// the home org) — see MembershipService.
model OrgMembership {
  id        String           @id @default(uuid())
  userId    String
  orgId     String
  role      Role             @default(STUDENT)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId, status])
  @@index([orgId, status])
}

model Bookmark {
  id       String  @id @default(uuid())
  userId   String
  unitId   String? // Optional relation
  customId String // The actual ID from frontend (Unit ID or Question ID)

  // Metadata for virtual units (questions from tests)
  title       String?
  type        String?
  courseTitle String?
  moduleTitle String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, customId])
  @@index([userId])
  @@index([customId])
}

model CourseProgress {
  id             String   @id @default(uuid())
  userId         String
  courseId       String
  completedUnits String[] // List of unit IDs completed
  totalUnits     Int
  completedCount Int
  percent        Int
  status         String // "Not Started", "In Progress", "Completed"

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model QuestionAttempt {
  id        String   @id @default(uuid())
  userId    String
  itemId    String // Unit ID or Exam Question ID
  sessionId String? // Reference to ExamSession if applicable
  type      String // "UNIT" or "EXAM"
  content   Json // The answer provided
  isCorrect Boolean  @default(false)
  score     Float?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, itemId])
  @@index([type])
  @@index([userId, createdAt]) // Used in analytics time-range queries
  @@index([sessionId]) // Used in attempt rollups
}

// ─── Groups & Announcements ────────────────────────────────────────────────────

model StudentGroup {
  id        String @id @default(uuid())
  name      String
  teacherId String
  teacher   User   @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: Cascade)

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  students      User[]         @relation("GroupStudents")
  announcements Announcement[] @relation("AnnouncementGroups")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([orgId])
}

model Announcement {
  id          String @id @default(uuid())
  title       String
  content     String // HTML from Tiptap rich text editor
  attachments Json   @default("[]") // Array of { name, url, type, size }

  teacherId String
  teacher   User   @relation("TeacherAnnouncements", fields: [teacherId], references: [id], onDelete: Cascade)

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  groups StudentGroup[]     @relation("AnnouncementGroups")
  reads  AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([orgId])
  @@index([createdAt])
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  userId         String
  announcementId String
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
}

model BugReport {
  id           String          @id @default(uuid())
  title        String
  description  String // HTML from Tiptap rich text editor
  status       BugReportStatus @default(OPEN)
  attachments  Json            @default("[]") // Array of { name, url, type, size }
  reporterRole Role

  reporterId String
  reporter   User   @relation("UserBugReports", fields: [reporterId], references: [id], onDelete: Cascade)

  fixedById String?
  fixedBy   User?   @relation("BugReportFixer", fields: [fixedById], references: [id], onDelete: SetNull)

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  fixedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([orgId])
  @@index([reporterId])
  @@index([fixedById])
}

model AiUsage {
  id               String   @id @default(uuid())
  orgId            String
  userId           String?
  provider         String
  model            String
  operation        String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@index([provider])
  @@index([operation])
}
